<?xml version="1.0"?>
<robot name="my_robot">

    <material name="white">
            <color rgba="1 1 1 1"/>
    </material>

    <material name="black">
            <color rgba="0.1 0.1 0.1 1"/>
    </material>

    <material name="orange">
            <color rgba="1 0.5 0 1"/>
    </material>

    <material name="red">
            <color rgba="0.8 0 0 1"/>
    </material>


    <link name="base_link">     
        <visual>
            <origin xyz="0 0 0.1" rpy="0 0 0"/>
            <geometry>
                <box size="0.65 0.45 0.2"/>
            </geometry>
            <material name="orange"/>
        </visual>       
    </link>

    <link name="lidar">
        <visual>
            <geometry>
                <cylinder radius="0.08" length="0.06" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" /> 
            <material name="red" /> 
        </visual> 
    </link>

    <link name="back_left_wheel"> 
        <visual>
            <geometry>
                <cylinder radius="0.08" length="0.04" />
            </geometry>
            <origin xyz="0 0 0" rpy="1.57 0 0" /> 
            <material name="black" /> 
        </visual>
    </link>

    <link name="front_left_wheel"> 
        <visual>
            <geometry>
                <cylinder radius="0.08" length="0.04" />
            </geometry>
            <origin xyz="0 0 0" rpy="1.57 0 0" /> 
            <material name="black" /> 
        </visual>
    </link>

    <link name="back_right_wheel"> 
        <visual>
            <geometry>
                <cylinder radius="0.08" length="0.04" />
            </geometry>
            <origin xyz="0 0 0" rpy="1.57 0 0" /> 
            <material name="black" /> 
        </visual>
    </link>

    <link name="front_right_wheel"> 
        <visual>
            <geometry>
                <cylinder radius="0.08" length="0.04" />
            </geometry>
            <origin xyz="0 0 0" rpy="1.57 0 0" /> 
            <material name="black" /> 
        </visual>
    </link>


    <joint name="base_lidar_joint" type="fixed"> 
        <parent link="base_link" /> 
        <child link="lidar" /> 
        <origin xyz="0 0 0.23" rpy="0 0 0" />
    </joint>

    <joint name="base_back_left_wheel_joint" type="continuous"> 
        <parent link="base_link" /> 
        <child link="back_left_wheel" /> 
        <origin xyz="-0.2 0.245 0" rpy="0 0 0" />
        <axis xyz="0 1 0" /> 
    </joint>

    <joint name="base_front_left_wheel_joint" type="continuous"> 
        <parent link="base_link" /> 
        <child link="front_left_wheel" /> 
        <origin xyz="0.2 0.245 0" rpy="0 0 0" />
        <axis xyz="0 1 0" /> 
    </joint>

    <joint name="base_back_right_wheel_joint" type="continuous"> 
        <parent link="base_link" /> 
        <child link="back_right_wheel" /> 
        <origin xyz="-0.2 -0.245 0" rpy="0 0 0" />
        <axis xyz="0 1 0" /> 
    </joint>

    <joint name="base_front_right_wheel_joint" type="continuous"> 
        <parent link="base_link" /> 
        <child link="front_right_wheel" /> 
        <origin xyz="0.2 -0.245 0" rpy="0 0 0" />
        <axis xyz="0 1 0" /> 
    </joint>

</robot>