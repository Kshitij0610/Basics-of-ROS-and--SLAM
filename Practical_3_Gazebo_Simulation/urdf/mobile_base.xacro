<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    
    <!-- Base link footprint for gazebo -->
    <link name="base_footprint"/>
    <joint name="base_footprint_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 0.1" rpy="0 0 0"/>
    </joint>

    <!-- Main Chassis -->
    <link name="base_link">     
        <visual>
            <origin xyz="0 0 0.1" rpy="0 0 0"/>
            <geometry>
                <box size="0.65 0.45 0.2"/>
            </geometry>
            <material name="orange"/>
        </visual>
        <collision>
            <origin xyz="0 0 0.1" rpy="0 0 0"/>
            <geometry>
                <box size="0.65 0.45 0.2"/>
            </geometry>
        </collision>
        <xacro:box_inertia m="5.0" w="0.45" h="0.65" d="0.2" 
                           x="0" y="0" z="0.1" r="0" p="0" y_rot="0"/>
    </link>

    <gazebo reference="base_link">
        <material>Gazebo/Orange</material>
    </gazebo>

    <!-- Wheels Macro -->
    <xacro:macro name="wheel" params="prefix x_reflect y_reflect">
        <link name="${prefix}_wheel">
            <visual>
                <geometry>
                    <cylinder radius="0.08" length="0.04" />
                </geometry>
                <origin xyz="0 0 0" rpy="1.57079632679 0 0" /> 
                <material name="black" /> 
            </visual>
            <collision>
                <geometry>
                    <cylinder radius="0.08" length="0.04" />
                </geometry>
                <origin xyz="0 0 0" rpy="1.57079632679 0 0" /> 
            </collision>
            <xacro:cylinder_inertia m="0.5" r="0.08" h="0.04" 
                                    x="0" y="0" z="0" roll="1.57079632679" pitch="0" yaw="0"/>
        </link>
        
        <joint name="base_${prefix}_wheel_joint" type="continuous"> 
            <parent link="base_link" /> 
            <child link="${prefix}_wheel" /> 
            <origin xyz="${x_reflect * 0.2} ${y_reflect * 0.245} 0" rpy="0 0 0" />
            <axis xyz="0 1 0" /> 
        </joint>

        <gazebo reference="${prefix}_wheel">
            <material>Gazebo/Black</material>
            <mu1 value="1.0"/>
            <mu2 value="1.0"/>
        </gazebo>
    </xacro:macro>

    <!-- Instantiate Wheels -->
    <xacro:wheel prefix="front_left" x_reflect="1" y_reflect="1"/>
    <xacro:wheel prefix="front_right" x_reflect="1" y_reflect="-1"/>
    <xacro:wheel prefix="back_left" x_reflect="-1" y_reflect="1"/>
    <xacro:wheel prefix="back_right" x_reflect="-1" y_reflect="-1"/>

    <!-- Lidar -->
    <link name="lidar">
        <visual>
            <geometry>
                <cylinder radius="0.08" length="0.06" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" /> 
            <material name="red" /> 
        </visual> 
        <collision>
            <geometry>
                <cylinder radius="0.08" length="0.06" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" /> 
        </collision>
        <xacro:cylinder_inertia m="0.2" r="0.08" h="0.06" 
                                x="0" y="0" z="0" roll="0" pitch="0" yaw="0"/>
    </link>

    <joint name="base_lidar_joint" type="fixed"> 
        <parent link="base_link" /> 
        <child link="lidar" /> 
        <!-- Placed slightly forward to leave room for the arm -->
        <origin xyz="0.2 0 0.23" rpy="0 0 0" />
    </joint>

    <gazebo reference="lidar">
        <material>Gazebo/Red</material>
    </gazebo>

    <!-- Gazebo Plugin for Skid Steer Drive -->
    <gazebo>
        <plugin name="skid_steer_drive" filename="libgazebo_ros_diff_drive.so">
            <ros>
                <namespace>/</namespace>
            </ros>
            <update_rate>50</update_rate>
            
            <num_wheel_pairs>2</num_wheel_pairs>

            <left_joint>base_front_left_wheel_joint</left_joint>
            <right_joint>base_front_right_wheel_joint</right_joint>

            <left_joint>base_back_left_wheel_joint</left_joint>
            <right_joint>base_back_right_wheel_joint</right_joint>

            <wheel_separation>0.49</wheel_separation>
            <wheel_separation>0.49</wheel_separation>
            <wheel_diameter>0.16</wheel_diameter>
            <wheel_diameter>0.16</wheel_diameter>

            <max_wheel_torque>20</max_wheel_torque>
            <max_wheel_acceleration>1.0</max_wheel_acceleration>

            <command_topic>cmd_vel</command_topic>
            <odometry_topic>odom</odometry_topic>
            <odometry_frame>odom</odometry_frame>
            <robot_base_frame>base_footprint</robot_base_frame>
            <publish_odom>true</publish_odom>
            <publish_odom_tf>true</publish_odom_tf>
            <publish_wheel_tf>true</publish_wheel_tf>
        </plugin>
    </gazebo>

</robot>
