<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <joint name="arm_base_joint" type="fixed">
        <parent link="base_link"/>
        <child link="arm_base_link"/>
        <origin xyz="-0.1 0 0.2" rpy="0 0 0"/>
    </joint>

    <!-- ARM BASE LINK -->
    <link name="arm_base_link">
        <visual>
            <origin xyz="0 0 0.05" rpy="0 0 0"/>
            <geometry>
                <box size="0.2 0.2 0.1"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin xyz="0 0 0.05" rpy="0 0 0"/>
            <geometry>
                <box size="0.2 0.2 0.1"/>
            </geometry>
        </collision>
        <xacro:box_inertia m="1.0" w="0.2" h="0.2" d="0.1" 
                                x="0" y="0" z="0.05" 
                                r="0" p="0" y_rot="0"/>
    </link>

    <!-- JOINT 1 (Yaw) -->
    <joint name="joint_1" type="revolute">
        <parent link="arm_base_link"/>
        <child link="link_1"/>
        <origin xyz="0 0 0.1" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-3.14159" upper="3.14159" effort="100.0" velocity="1.0"/>
    </joint>

    <!-- LINK 1 -->
    <link name="link_1">
        <visual>
            <origin xyz="0 0 0.15" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.0375" length="0.3"/>
            </geometry>
            <material name="purple"/>
        </visual>
        <collision>
            <origin xyz="0 0 0.15" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.0375" length="0.3"/>
            </geometry>
        </collision>
        <xacro:cylinder_inertia m="0.5" r="0.0375" h="0.3" 
                                x="0" y="0" z="0.15" 
                                roll="0" pitch="0" yaw="0"/>
    </link>

    <!-- Sphere for JOINT 1 -->
    <link name="link_1_sphere">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <sphere radius="0.045"/>
            </geometry>
            <material name="black"/>
        </visual>
    </link>
    <joint name="link_1_sphere_joint" type="fixed">
        <parent link="link_1"/>
        <child link="link_1_sphere"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <!-- JOINT 2 (Pitch) -->
    <joint name="joint_2" type="revolute">
        <parent link="link_1"/>
        <child link="link_2"/>
        <origin xyz="0 0 0.3" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-1.5708" upper="1.5708" effort="100.0" velocity="1.0"/>
    </joint>

    <!-- LINK 2 -->
    <link name="link_2">
        <visual>
            <origin xyz="0 0 0.1125" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.03" length="0.225"/>
            </geometry>
            <material name="orange"/>
        </visual>
        <collision>
            <origin xyz="0 0 0.1125" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.03" length="0.225"/>
            </geometry>
        </collision>
        <xacro:cylinder_inertia m="0.4" r="0.03" h="0.225" 
                                x="0" y="0" z="0.1125" 
                                roll="0" pitch="0" yaw="0"/>
    </link>

    <!-- Sphere for JOINT 2 -->
    <link name="link_2_sphere">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <sphere radius="0.0375"/>
            </geometry>
            <material name="black"/>
        </visual>
    </link>
    <joint name="link_2_sphere_joint" type="fixed">
        <parent link="link_2"/>
        <child link="link_2_sphere"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <!-- JOINT 3 (Pitch) -->
    <joint name="joint_3" type="revolute">
        <parent link="link_2"/>
        <child link="link_3"/>
        <origin xyz="0 0 0.225" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-1.5708" upper="1.5708" effort="100.0" velocity="1.0"/>
    </joint>

    <!-- LINK 3 -->
    <link name="link_3">
        <visual>
            <origin xyz="0 0 0.075" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.0225" length="0.15"/>
            </geometry>
            <material name="red"/>
        </visual>
        <collision>
            <origin xyz="0 0 0.075" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.0225" length="0.15"/>
            </geometry>
        </collision>
        <xacro:cylinder_inertia m="0.2" r="0.0225" h="0.15" 
                                x="0" y="0" z="0.075" 
                                roll="0" pitch="0" yaw="0"/>
    </link>

    <!-- Sphere for JOINT 3 -->
    <link name="link_3_sphere">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <sphere radius="0.03"/>
            </geometry>
            <material name="black"/>
        </visual>
    </link>
    <joint name="link_3_sphere_joint" type="fixed">
        <parent link="link_3"/>
        <child link="link_3_sphere"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <!-- END EFFECTOR JOINT (Fixed) -->
    <joint name="end_effector_joint" type="fixed">
        <parent link="link_3"/>
        <child link="end_effector_link"/>
        <origin xyz="0 0 0.15" rpy="0 0 0"/>
    </joint>

    <!-- END EFFECTOR LINK -->
    <link name="end_effector_link">
        <visual>
            <origin xyz="0 0 0.015" rpy="0 0 0"/>
            <geometry>
                <sphere radius="0.03"/>
            </geometry>
            <material name="yellow"/>
        </visual>
        <collision>
            <origin xyz="0 0 0.015" rpy="0 0 0"/>
            <geometry>
                <sphere radius="0.03"/>
            </geometry>
        </collision>
        <xacro:sphere_inertia m="0.1" r="0.03" 
                              x="0" y="0" z="0.015" 
                              roll="0" pitch="0" yaw="0"/>
    </link>

</robot>
