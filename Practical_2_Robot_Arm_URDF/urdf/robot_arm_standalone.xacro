<?xml version="1.0"?>
<!--
  robot_arm_standalone.xacro
  ===========================
  Root file for Practical 2: 3-DOF Robot Arm (visualized in RViz without a mobile base).
  It includes common material/inertia helpers and the arm geometry.
  The arm_base_link is attached directly to "world" here so it stands alone.

  CUSTOMISABLE PARAMETERS:
  See robot_arm_core_standalone.xacro for all size/colour values.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robot_arm_standalone">

    <xacro:include filename="common_properties.xacro" />
    <xacro:include filename="robot_arm_core_standalone.xacro" />

</robot>
